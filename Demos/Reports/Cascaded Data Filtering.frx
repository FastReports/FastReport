          <TextObject Name="Text5" Left="245.7" Top="9.45" Width="94.5" Height="18.9" Text="[Order Details.UnitPrice]" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Segoe UI, 9pt"/>
          <TextObject Name="Text6" Left="359.1" Top="9.45" Width="37.8" Height="18.9" Text="[Order Details.Quantity]" Font="Segoe UI, 9pt"/>
