      <TextObject Name="Text11" Left="311.85" Top="9.45" Width="85.05" Height="18.9" Text="Total:" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Segoe UI, 9pt, style=Bold"/>
