    <ButtonControl Name="btnOk" Left="292" Top="254" Width="150" Height="46" Anchor="Bottom, Right" Font="Segoe UI, 9pt" TabIndex="1" Text="OK" DialogResult="OK"/>
    <LabelControl Name="Label1" Left="24" Top="84" Width="113" Font="Segoe UI, 9pt" TabIndex="3" Text="Employee:"/>
    <ComboBoxControl Name="EmployeesComboBox" Left="184" Top="80" Width="370" Height="44" Font="Segoe UI, 9pt" TabIndex="4" TabStop="true" AutoFilter="false" DataColumn="Employees.FirstName" DetailControl="OrdersComboBox" DropDownStyle="DropDownList" DropDownWidth="185" ItemHeight="12" ItemsText="Anne&#13;&#10;Andrew&#13;&#10;Janet&#13;&#10;Margaret&#13;&#10;Steven&#13;&#10;Michael&#13;&#10;Robert&#13;&#10;Laura&#13;&#10;Nancy" SelectedIndexChangedEvent="EmployeesComboBox_SelectedIndexChanged"/>
