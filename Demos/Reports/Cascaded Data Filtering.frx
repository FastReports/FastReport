        <TextObject Name="Text3" Left="160.65" Top="9.45" Width="198.45" Height="18.9" Text="Date: [Orders.OrderDate]" Format="Date" Format.Format="d" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="White"/>
        <DataBand Name="Data3" Top="89.05" Width="718.2" Height="37.8" DataSource="Order Details">
