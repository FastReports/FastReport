          <TextObject Name="Text8" Left="415.8" Top="9.45" Width="75.6" Height="18.9" Text="[[Order Details.UnitPrice] * [Order Details.Quantity]]" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Segoe UI, 9pt"/>
          <TextObject Name="Text9" Left="396.9" Top="9.45" Width="18.9" Height="18.9" Text="=" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" Font="Segoe UI, 9pt"/>
        </DataBand>
      </DataBand>
    </DataBand>
