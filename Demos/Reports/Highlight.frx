          <TableCell Name="Cell10" Border.Lines="All" Border.Color="White" Fill.Color="160, 120, 120" Text="Total" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="White"/>
