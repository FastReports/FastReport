          <TableCell Name="Cell4" Border.Lines="All" Border.Color="White" Fill.Color="160, 120, 120" Text="[Month]" AllowExpressions="false" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="White"/>
          <TableCell Name="Cell8" Border.Lines="All" Border.Color="White" Fill.Color="WhiteSmoke" Text="[Revenue]" AllowExpressions="false" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt">
            <Highlight>
              <Condition Expression="Value &gt; 3000" Fill.Color="200, 160, 120" TextFill.Color="Black" Font="Arial, 10pt" ApplyFill="true"/>
