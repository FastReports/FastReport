<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="Demonstrates the following AdvMatrixObject features:&#13;&#10;- collapse/expand header elements;&#13;&#10;- stepped layout of row groups;&#13;&#10;- use of Display Text setting for &quot;Month&quot; element" ReportInfo.Created="09/01/2021 21:12:23" ReportInfo.Modified="04/07/2023 01:06:24" ReportInfo.CreatorVersion="1.0.0.0">
  <Dictionary>
