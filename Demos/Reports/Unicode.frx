      <TextObject Name="Text9" Left="94.5" Top="47.25" Width="623.7" Height="31.22" Border.Lines="All" Border.Color="Gainsboro" Text="You may use any font to display international characters. If a specific font misses some character, another font will be used instead (font fallback feature). Font fallback is supported in the PDF export as well." VertAlign="Center" Font="Segoe UI, 9pt"/>
      <PictureObject Name="Picture1" Top="47.25" Width="88" Height="31" Border.Lines="All" Border.Color="Gainsboro" Hyperlink.Value="http://www.unicode.org/" SizeMode="AutoSize" ImageFormat="Png" Image=""/>
    </ReportTitleBand>
    <PageHeaderBand Name="PageHeader1" Top="87.05" Width="718.2" Height="28.35">
