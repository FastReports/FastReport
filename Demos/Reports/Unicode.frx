<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="This report demonstrates Unicode samples.&#13;&#10;&#13;&#10;You may use any font to display international characters. If a specific font misses some character, another font will be used instead (font fallback feature). Font fallback is supported in the PDF export as well." ReportInfo.Created="12/12/2008 01:29:01" ReportInfo.Modified="03/28/2023 20:04:45" ReportInfo.CreatorVersion="1.0.0.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {

    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      Text4.RightToLeft = ((Boolean)Report.GetColumnValue(&quot;Unicode.Rtl&quot;)) == true;
      Text6.RightToLeft = Text4.RightToLeft;
    }
  }
}
</ScriptText>
  <Dictionary>
    <TableDataSource Name="Unicode" ReferenceName="NorthWind.Unicode" DataType="System.Int32" Enabled="true" SelectCommand="select * from unicode order by UnicodeName">
      <Column Name="Name" DataType="System.String"/>
      <Column Name="UnicodeName" DataType="System.String"/>
      <Column Name="Text" DataType="System.String"/>
      <Column Name="Rtl" DataType="System.Boolean" BindableControl="CheckBox"/>
      <Column Name="Active" DataType="System.Boolean" BindableControl="CheckBox"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" Watermark.Font="Arial, 60pt">
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="85.05" CanGrow="true">
