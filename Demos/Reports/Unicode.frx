      <TextObject Name="Text5" Left="94.5" Width="94.5" Height="28.35" Border.Lines="All" Border.Color="White" Fill.Color="100, 170, 180" Text="Self name" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
      <TextObject Name="Text7" Left="189" Width="529.2" Height="28.35" Border.Lines="All" Border.Color="White" Fill.Color="100, 170, 180" Text="Text" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
    </PageHeaderBand>
    <DataBand Name="Data1" Top="117.4" Width="718.2" Height="37.8" CanGrow="true" BeforePrintEvent="Data1_BeforePrint" DataSource="Unicode">
      <TextObject Name="Text2" Top="9.45" Width="94.5" Height="28.35" Border.Lines="Left, Right, Bottom" Border.Color="White" Fill.Color="100, 170, 180" Text="[Unicode.Name]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text4" Left="94.5" Top="9.45" Width="94.5" Height="28.35" Border.Lines="Left, Right, Bottom" Border.Color="White" Fill.Color="100, 170, 180" Text="[Unicode.UnicodeName]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
