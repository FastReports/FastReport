          <TableCell Name="Cell2" Border.Lines="All" Border.Color="White" Fill.Color="160, 120, 160" Text="[Year]" AllowExpressions="false" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="White" ColSpan="2"/>
