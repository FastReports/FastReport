<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="Demonstrates how to create an interactive report using MSChartObject. This report uses same technique described in the &quot;Interactive Reports&quot; section. Just set up the chart's Hyperlink to view another page in this report. Chart will automatically set the hyperlink's Value property when you click a data point." ReportInfo.Created="03/06/2009 03:34:28" ReportInfo.Modified="04/07/2023 00:54:49" ReportInfo.CreatorVersion="1.0.0.0">
  <Dictionary>
    <TableDataSource Name="MatrixDemo" ReferenceName="NorthWind.MatrixDemo" DataType="System.Int32" Enabled="true">
      <Column Name="Name" DataType="System.String"/>
      <Column Name="Year" DataType="System.Int32"/>
      <Column Name="Month" DataType="System.Int32"/>
      <Column Name="ItemsSold" DataType="System.Int32"/>
      <Column Name="Revenue" DataType="System.Decimal"/>
    </TableDataSource>
    <Parameter Name="SelectedEmployee" DataType="System.String" AsString="Janet Leverling"/>
    <Total Name="TotalItems" Expression="[MatrixDemo.ItemsSold]" Evaluator="Data2" PrintOn="ReportSummary1"/>
    <Total Name="TotalRevenue" Expression="[MatrixDemo.Revenue]" Evaluator="Data2" PrintOn="ReportSummary1"/>
  </Dictionary>
  <ReportPage Name="Page1" Watermark.Font="Arial, 60pt">
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="37.8" CanGrow="true">
      <TextObject Name="Text15" Width="718.2" Height="37.8" Text="Interactive Chart demo" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 16pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="Data1" Top="39.8" Width="718.2" Height="378">
      <MSChartObject Name="MSChart1" Left="28.35" Top="9.45" Width="670.95" Height="330.75" Border.Lines="All" Border.Color="LightGray" Hyperlink.Kind="DetailPage" Hyperlink.DetailPageName="Page2" Hyperlink.ReportParameter="SelectedEmployee" DataSource="MatrixDemo" Filter="" ChartData="">
        <MSChartSeries Name="Series4" GroupBy="XValue" PieExplode="BiggestValue" XValue="[MatrixDemo.Name]" YValue1="[MatrixDemo.ItemsSold]"/>
      </MSChartObject>
      <TextObject Name="Text12" Left="226.8" Top="349.65" Width="283.5" Height="28.35" Text="Click on pie slice to view detailed report." Padding="2, 2, 2, 2" Font="Segoe UI, 9pt"/>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Top="419.8" Width="718.2" Height="28.35" Fill.Color="WhiteSmoke">
      <TextObject Name="Text27" Left="9.45" Width="217.35" Height="28.35" Cursor="Hand" Hyperlink.Value="https://www.fast-report.com/products/fast-report-net" Text="Generated by FastReport" VertAlign="Center" Font="Segoe UI, 9pt, style=Underline" TextFill.Color="Blue"/>
    </PageFooterBand>
  </ReportPage>
  <ReportPage Name="Page2" Visible="false" Watermark.Font="Arial, 60pt">
    <ReportTitleBand Name="ReportTitle2" Width="718.2" Height="47.25" CanGrow="true">
      <TextObject Name="Text26" Width="434.7" Height="37.8" Text="[SelectedEmployee] orders" VertAlign="Center" Font="Segoe UI, 14pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="Data2" Top="70.15" Width="718.2" Height="18.9" DataSource="MatrixDemo" Filter="[MatrixDemo.Name] == [SelectedEmployee]">
      <TextObject Name="Text17" Width="66.15" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[MatrixDemo.Year]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text18" Left="66.15" Width="66.15" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[MatrixDemo.Month]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text19" Left="132.3" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[MatrixDemo.ItemsSold]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text20" Left="207.9" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[MatrixDemo.Revenue]" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <DataHeaderBand Name="DataHeader1" Top="49.25" Width="718.2" Height="18.9">
        <TextObject Name="Text22" Width="66.15" Height="18.9" Border.Lines="All" Border.Color="LightGray" Fill.Color="Gold" Text="Year" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
        <TextObject Name="Text23" Left="66.15" Width="66.15" Height="18.9" Border.Lines="All" Border.Color="LightGray" Fill.Color="Gold" Text="Month" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
        <TextObject Name="Text24" Left="132.3" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Fill.Color="Gold" Text="ItemsSold" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
        <TextObject Name="Text25" Left="207.9" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Fill.Color="Gold" Text="Revenue" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
      </DataHeaderBand>
    </DataBand>
    <ReportSummaryBand Name="ReportSummary1" Top="91.05" Width="718.2" Height="37.8">
      <TextObject Name="Text1" Left="132.3" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[TotalItems]" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text2" Left="207.9" Width="75.6" Height="18.9" Border.Lines="All" Border.Color="LightGray" Text="[TotalRevenue]" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text3" Left="66.15" Width="66.15" Height="18.9" Text="Total:" HorzAlign="Center" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter2" Top="130.85" Width="718.2" Height="28.35" Fill.Color="WhiteSmoke">
      <TextObject Name="Text29" Left="9.45" Width="217.35" Height="28.35" Cursor="Hand" Hyperlink.Value="https://www.fast-report.com/products/fast-report-net" Text="Generated by FastReport" VertAlign="Center" Font="Segoe UI, 9pt, style=Underline" TextFill.Color="Blue"/>
    </PageFooterBand>
  </ReportPage>
</Report>
