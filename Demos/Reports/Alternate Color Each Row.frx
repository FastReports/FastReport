<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Description="This report demonstrates how to highlight each second row. To do this:&#13;&#10;- select all matrix body cells;&#13;&#10;- click the &quot;Highlight&quot; button on the &quot;Text&quot; toolbar;&#13;&#10;- add the following condition: &quot;Matrix1.RowIndex % 2 != 0&quot; and set the fill color.&#13;&#10;&#13;&#10;Note: you may also use Matrix1.ColumnIndex value." ReportInfo.Created="05/16/2008 01:44:40" ReportInfo.Modified="04/07/2023 18:05:05" ReportInfo.CreatorVersion="1.0.0.0">
