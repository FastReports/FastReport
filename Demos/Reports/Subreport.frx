      <TextObject Name="Text21" Left="94.5" Top="94.5" Width="151.2" Height="18.9" Border.Lines="Left" Border.Color="White" Fill.Color="WhiteSmoke" Text="[Suppliers.City]" Padding="5, 2, 0, 0" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text22" Left="94.5" Top="113.4" Width="151.2" Height="18.9" Border.Lines="Left" Border.Color="White" Fill.Color="WhiteSmoke" Text="[Suppliers.Region]" Padding="5, 2, 0, 0" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text23" Left="94.5" Top="170.1" Width="151.2" Height="18.9" Border.Lines="Left" Border.Color="White" Fill.Color="WhiteSmoke" Text="[Suppliers.ContactName]" Padding="5, 2, 0, 0" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text24" Left="94.5" Top="189" Width="151.2" Height="18.9" Border.Lines="Left" Border.Color="White" Fill.Color="WhiteSmoke" Text="[Suppliers.ContactTitle]" Padding="5, 2, 0, 0" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <LineObject Name="Line1" Left="708.75" Top="37.8" Height="170.1" Border.Color="Gainsboro"/>
      <LineObject Name="Line2" Left="245.7" Top="207.9" Width="463.05" Border.Color="Gainsboro"/>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Top="278.05" Width="718.2" Height="28.35" Fill.Color="WhiteSmoke">
      <TextObject Name="Text7" Left="614.25" Width="94.5" Height="28.35" Text="[PageN]" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text26" Left="9.45" Width="217.35" Height="28.35" Cursor="Hand" Hyperlink.Value="https://www.fast-report.com/products/fast-report-net" Text="Generated by FastReport" VertAlign="Center" Font="Segoe UI, 9pt, style=Underline" TextFill.Color="Blue"/>
    </PageFooterBand>
  </ReportPage>
  <ReportPage Name="Page2" Watermark.Font="Arial, 60pt">
    <DataBand Name="Data2" Top="20.9" Width="718.2" Height="18.9" DataSource="Products">
      <TextObject Name="Text1" Left="9.45" Width="311.85" Height="18.9" EvenStyle="EvenRows" Text="[Products.ProductName]" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <TextObject Name="Text2" Left="321.3" Width="94.5" Height="18.9" EvenStyle="EvenRows" Text="[Products.UnitPrice]" Format="Currency" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt"/>
      <DataHeaderBand Name="DataHeader1" Width="718.2" Height="18.9">
        <TextObject Name="Text3" Left="9.45" Width="311.85" Height="18.9" Text="Product name" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
        <TextObject Name="Text4" Left="321.3" Width="94.5" Height="18.9" Text="Unit price" HorzAlign="Right" VertAlign="Center" Font="Segoe UI, 9pt, style=Bold"/>
      </DataHeaderBand>
      <DataFooterBand Name="DataFooter1" Top="41.8" Width="718.2" Height="18.9">
