<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;Demo</Configurations>
    <PackageReleaseNotes></PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>MONO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Demo'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);Demo</DefineConstants>
  </PropertyGroup>
  <Import Project="..\Shared.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\fastreport_transports\FastReport.Transport.Avalonia\FastReport.Transport.Avalonia.csproj" />
    <ProjectReference Include="..\..\..\..\..\FastReport.Avalonia\FastReport.Avalonia.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Remove="..\ButtonWrapper.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\FastReport.SkiaDrawing\FastReport.SkiaDrawing.csproj" />
    <ProjectReference Include="..\..\..\..\..\FastReport.Forms.Avalonia\FastReport.Forms.Avalonia.csproj" />
  </ItemGroup>
  <!-- disable transitive reference to System.Drawing.Common (used in Avalonia.Win32). PrivateAssets does not work in this case -->
  <Target Name="ProcessSDCAssemblies" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'System.Drawing.Common'">
        <Aliases>nonmerged</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
